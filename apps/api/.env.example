# Local development only. Docker Compose overrides DATABASE_URL, REDIS_URL and PORT.
# Generate a unique value for JWT_SECRET: openssl rand -hex 32
JWT_SECRET=

# For API development directly on your host (PostgreSQL exposed at localhost:5434):
DATABASE_URL=postgres://crm_app:crm_app@localhost:5434/crm
MIGRATION_DATABASE_URL=postgres://crm:crm@localhost:5434/crm
PORT=3000

# Optional observability credentials (not required by Docker Compose quickstart):
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
